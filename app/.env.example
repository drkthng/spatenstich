# app/.env.example (public-only)
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
EXPO_PUBLIC_SENTRY_DSN=https://<eu-dsn>@o<org>.ingest.de.sentry.io/<project>

# Optional, shown on the Impressum screen. Not needed while the app is run privately for one
# household; without it the screen says exactly that. Set as a build variable, not in a committed file
# (the repository is public). Lines separated by "|".
# EXPO_PUBLIC_IMPRINT=Vorname Nachname|Straße 1|12345 Ort|name@example.org
# Set by the deploy workflow: commit and day of the build.
# EXPO_PUBLIC_BUILD_SHA=
# EXPO_PUBLIC_BUILD_DATE=
